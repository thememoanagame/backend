{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "MemoAna: Debug",
            "type": "process",
            "command": "dotnet",
            "args": [
                "run",
                "--project",
                "${workspaceFolder}/src/MemoAna/MemoAna.csproj",
                "-c",
                "Debug",
            ],
            "problemMatcher": "$msCompile",
            "presentation": {
                "reveal": "always",
                "panel": "dedicated",
                "clear": true,
                "showReuseMessage": false
            }
        },
        {
            "label": "MemoAna: Docker",
            "type": "shell",
            "command": "docker compose up -d --build",
            "problemMatcher": []
        },
        {
            "label": "MemoAna: Setup Infisical",
            "type": "shell",
            "command": "powershell",
            "args": [
                "-ExecutionPolicy",
                "Bypass",
                "-File",
                "${workspaceFolder}/scripts/infisical.ps1"
            ],
            "problemMatcher": []
        },
        {
            "label": "MemoAna: Build + Infisical",
            "type": "shell",
            "command": "infisical",
            "args": [
                "run",
                "--env=dev",
                "--",
                "dotnet",
                "build",
                "${workspaceFolder}/src/MemoAna/MemoAna.csproj",
                "/property:GenerateFullPaths=true",
                "/consoleloggerparameters:NoSummary"
            ],
            "group": {
                "kind": "build",
                "isDefault": true
            },
            "dependsOn": [
                "MemoAna: Setup Infisical"
            ],
            "problemMatcher": "$msCompile"
        },
        {
            "label": "MemoAna: Reopen VS Code with Infisical",
            "type": "shell",
            "command": "infisical",
            "args": [
                "run",
                "--env=dev",
                "--",
                "code",
                "--reuse-window",
                "${workspaceFolder}"
            ],
            "dependsOn": [
                "MemoAna: Setup Infisical"
            ],
            "problemMatcher": []
        }
    ] 
}