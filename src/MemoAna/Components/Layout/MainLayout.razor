@inherits LayoutComponentBase
<MudThemeProvider />
<MudDialogProvider /> 
<MudPopoverProvider /> 
<MudSnackbarProvider />
<MudLayout>
    <MudAppBar>
        <MudIconButton Icon="@Icons.Material.Filled.Menu" Color="Color.Inherit" Edge="Edge.Start" OnClick="@((e) => DrawerToggle())" />
        MemoAna
    </MudAppBar>
    <MudDrawer @bind-Open="@_drawerOpen">
        <NavMenu />
    </MudDrawer>
    <MudMainContent>
        @Body
    </MudMainContent>
</MudLayout>

<div id="blazor-error-ui" class="mud-blazor-error-ui" data-nosnippet style="display: none;">
    <MudAlert Severity="Severity.Error" Variant="Variant.Filled" Square="true" Class="d-flex align-center justify-space-between py-2 px-4">
        <div class="d-flex align-center gap-2">
            <span>Ocorreu um erro não tratado na aplicação.</span>
            <a href="." class="reload mud-typography mud-link mud-primary-text font-weight-bold" style="color: var(--mud-palette-white) !important; text-decoration: underline;">
                Recarregar
            </a>
        </div>
        <span class="dismiss cursor-pointer ml-4" style="font-size: 1.2rem; line-height: 1;">🗙</span>
    </MudAlert>
</div>
@code {
    bool _drawerOpen = true;

    void DrawerToggle()
    {
        _drawerOpen = !_drawerOpen;
    }
}