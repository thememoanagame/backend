@page "/seed"
@using Mediator
@using MemoAna.Application.Common.Responses
@using MemoAna.Application.Seed.Dtos
@using MemoAna.Application.Seed.Queries
@inject IMediator Mediator

<MudContainer MaxWidth="MaxWidth.Medium" Class="pa-6">
    <MudStack Spacing="3">
        <MudText Typo="Typo.h4">Application initialization</MudText>

        @if (_status is null)
        {
            <MudProgressCircular Indeterminate="true" />
        }
        else if (!_status.SeedRequired)
        {
            <MudAlert Severity="Severity.Success">
                The application is initialized.
            </MudAlert>
        }
        else
        {
            <MudAlert Severity="Severity.Warning">
                The application requires initialization.
            </MudAlert>
            <MudList Dense="true" T="MudListItem<string>">
                @foreach (string requirement in _status.MissingRequirements)
                {
                    <MudListItem T="string" Text="@requirement" />
                }
            </MudList>
        }
    </MudStack>
</MudContainer>

@code {
    private SeedStatusDto? _status;

    protected override async Task OnInitializedAsync()
    {
        await RefreshStatusAsync();
    }

    private async Task RefreshStatusAsync()
    {
        Response<SeedStatusDto> response = await Mediator.Send(
            new GetSeedStatusQuery(),
            CancellationToken.None);
        _status = response.Data;
    }
}
