<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <BlazorDisableThrowNavigationException>true</BlazorDisableThrowNavigationException>
    <UserSecretsId>9744d610-556e-406b-aab4-2446776d1046</UserSecretsId>
    <DockerDefaultTargetOS>Linux</DockerDefaultTargetOS>
    <DockerfileContext>..\..\..</DockerfileContext>
    <DockerComposeProjectPath>..\..\..\docker-compose.dcproj</DockerComposeProjectPath>
  </PropertyGroup>
  
  <ItemGroup>
    <PackageReference Include="FluentValidation" Version="12.1.1" />
    <PackageReference Include="LiteDB" Version="5.0.21" />
    <PackageReference Include="Microsoft.AspNetCore.OpenApi" Version="10.0.12" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design" Version="10.0.12">
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
    <PackageReference Include="Microsoft.EntityFrameworkCore.Sqlite" Version="10.0.12" /> 
    <PackageReference Include="Microsoft.VisualStudio.Azure.Containers.Tools.Targets" Version="1.23.0" />
    <PackageReference Include="MudBlazor" Version="9.10.0" />
    <PackageReference Include="Scalar.AspNetCore" Version="2.17.6" />
  </ItemGroup>
  
  <ItemGroup>
    <ProjectReference Include="..\MemoAna.Application\MemoAna.Application.csproj" />
    <ProjectReference Include="..\MemoAna.Composition\MemoAna.Composition.csproj" />
  </ItemGroup>

   <!-- Target to create EF Core migrations and skip the main build pipeline -->
  <Target Name="AddMigration" BeforeTargets="BeforeBuild" Condition="'$(MigrationName)' != ''">
    <!-- Set default value for Verb parameter if not provided -->
    <PropertyGroup>
      <Verb Condition="'$(Verb)' == ''">false</Verb>
    </PropertyGroup>

    <Message Importance="high" Text="Starting EF Core migration generation process..." />
    <Message Importance="high" Text="Migration Name: $(MigrationName)" />
    <Message Importance="high" Text="Verbose Mode: $(Verb)" />

    <!-- Construct the base command arguments -->
    <PropertyGroup>
      <_EfArgs>ef migrations add $(MigrationName) -s "$(MSBuildProjectDirectory)" -p "$(MSBuildProjectDirectory)\..\MemoAna.Infrastructure" --output-dir Persistence/Migrations</_EfArgs>
      <!-- Append verbose flag if Verb is true -->
      <_EfArgs Condition="'$(Verb)' == 'true'">$(_EfArgs) --verbose</_EfArgs>
    </PropertyGroup>

    <!-- Execute the dotnet ef CLI command -->
    <Exec Command="dotnet $(_EfArgs)" ContinueOnError="true" ConsoleToMsBuild="true">
      <Output TaskParameter="ExitCode" PropertyName="_EfExitCode" />
    </Exec>

    <!-- Handle command failure -->
    <Warning Condition="'$(_EfExitCode)' != '0'" Text="EF Core migration generation failed with exit code $(_EfExitCode)." />

    <!-- Handle command success -->
    <Message Condition="'$(_EfExitCode)' == '0'" Importance="high" Text="EF Core migration '$(MigrationName)' successfully created." />

    <!-- Stop the MSBuild process regardless of outcome to prevent the actual project build -->
    <Error Text="Canceling build process as requested after running migration target." />
  </Target>

  <!-- Validation target when MigrationName is missing -->
  <Target Name="ValidateAddMigrationParams" BeforeTargets="BeforeBuild" Condition="'$(MSBuildTargets)' == 'AddMigration' And '$(MigrationName)' == ''">
    <Error Text="Parameter 'MigrationName' is required. Usage: dotnet build -t:AddMigration -p:MigrationName=MyMigration [-p:Verb=true]" />
  </Target>

</Project>
